{
  "name": "@remo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=4",
    "build": "vite build",
    "build:demo": "vite build --mode hosted-demo"
  },
  "dependencies": {
    "@remo/domain": "workspace:*",
    "@rrweb/replay": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "jsdom": "27.4.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
